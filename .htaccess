RewriteEngine On

# ---------------------------------------
# 🔥 1. Redirect non-www to www (optional)
# Uncomment if you want www version
#RewriteCond %{HTTP_HOST} ^shivamtourstravels\.in [NC]
#RewriteRule ^(.*)$ https://www.shivamtourstravels.in/$1 [L,R=301]

# If you want NON-WWW (recommended for SEO):
RewriteCond %{HTTP_HOST} ^www\.shivamtourstravels\.in [NC]
RewriteRule ^(.*)$ https://shivamtourstravels.in/$1 [L,R=301]


# ---------------------------------------
# 🔥 2. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://shivamtourstravels.in/$1 [L,R=301]


# ---------------------------------------
# 🔥 3. Remove .html from URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ $1.html [L]

# Redirect old .html pages TO new extensionless URLs
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?]
RewriteRule ^ %1 [R=301,L]


# ---------------------------------------
# 🔥 4. SEO Friendly 404 Redirect
ErrorDocument 404 /404.html

